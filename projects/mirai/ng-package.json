{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/mirai",
  "lib": {
    "entryFile": "src/public-api.ts"
  },
  "assets": [
    {
      "input": "src",
      "glob": "styles.css",
      "output": "."
    },
    {
      "input": "src/styles",
      "glob": "**/*.css",
      "output": "styles"
    }
  ]
}
